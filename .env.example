# --- MongoDB Atlas ---
# Atlas > Connect > Drivers > copy the string, put your password in, and add the DB name before the "?"
MONGODB_URI=mongodb+srv://trueyarn?:password@cluster.mongodb.net/

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Admin auth ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Used ONLY by `npm run seed` to create the first admin account. Change the password!
ADMIN_USERNAME=maria.clara
ADMIN_PASSWORD=ChangeThisPassword123
ADMIN_NAME=Maria Clara

# --- Booking rules (times are Philippine Time, UTC+8) ---
OPEN_HOUR=9
CLOSE_HOUR=21
MIN_LEAD_HOURS=2
MAX_ADVANCE_DAYS=60
DEPOSIT_RATE=0.2
